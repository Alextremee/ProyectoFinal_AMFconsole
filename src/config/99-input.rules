# Acceso a dispositivos de entrada (SDL2 KMS necesita esto)
KERNEL=="event*", MODE="0666", GROUP="input"
KERNEL=="js*", MODE="0666", GROUP="input"
KERNEL=="mouse*", MODE="0666", GROUP="input"
KERNEL=="uinput", MODE="0666", GROUP="input"

# Sony DualSense específicamente
SUBSYSTEM=="input", ATTRS{idVendor}=="054c", MODE="0666", GROUP="input"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="054c", MODE="0666", GROUP="input"
