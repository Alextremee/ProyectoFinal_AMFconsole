config BR2_PACKAGE_RETROCONSOLE_FRONTEND
	bool "retroconsole-frontend"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_SDL2_TTF
	help
	  Frontend de galeria de juegos para la consola retro.
	  Codigo propio en C++17 sobre SDL2 directo en framebuffer.
	  Lanza Mednafen al pulsar boton de confirmar.

comment "retroconsole-frontend needs a toolchain w/ C++, threads"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS
